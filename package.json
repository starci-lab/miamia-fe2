{
  "name": "miamia-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build": "next build",
    "start": "next start --hostname localhost --port 3071",
    "lint": "npm run lint:check",
    "lint:check": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "seed:test-account": "node --env-file-if-exists=.env.local scripts/provision-test-account.mjs",
    "sync:ports": "node scripts/sync-ports.mjs",
    "test:cov": "vitest run --coverage",
    "test:cov:check": "vitest run --coverage && node scripts/check-coverage.mjs",
    "test:e2e": "npm run build && node scripts/e2e-http.mjs",
    "sonar:check": "sonar-scanner-npm -Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=600"
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.4.0",
    "@heroicons/react": "^2.2.0",
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@iconify/react": "^6.0.2",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "colyseus.js": "^0.16.22",
    "framer-motion": "^13.1.0",
    "graphql": "^16.14.1",
    "next": "16.1.6",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "phaser": "^3.90.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@starci/eslint-canon-fe": "^1.3.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "jsdom": "^30",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4",
    "@sonar/scan": "^5.0.0"
  }
}
